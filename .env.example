# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sst-live?retryWrites=true&w=majority
# Long random string used to sign login tokens (e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=change-me
# Optional: port (Render sets this automatically)
PORT=3000

# Used only by `npm run seed` to create the first admin account
SEED_ADMIN_EMAIL=admin@sst.edu
SEED_ADMIN_PASSWORD=choose-a-strong-password
